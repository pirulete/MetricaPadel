# Auth - JWT Secret for Auth.js (REQUIRED in production)
# Generate with: openssl rand -base64 32
# En desarrollo, auth.ts genera un fallback automático si no está configurada.
# En producción, debe estar configurada en Vercel → Settings → Environment Variables.
NEXTAUTH_SECRET=your-secret-here

# Auth - Session config (fallback si session_config no tiene fila en DB)
# TTL del access token en minutos (default 15). La fila en session_config tiene prioridad.
SESSION_ACCESS_TOKEN_TTL=15

# Analytics - Google Tag Manager (opcional)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Analytics - Google Analytics 4 (direct, if not using GTM)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Analytics - Meta Pixel (opcional)
NEXT_PUBLIC_META_PIXEL_ID=123456789

# Database - NeonDB (PostgreSQL serverless)
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_PROD=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Database Branching — Preview environment isolation
# Solo necesario para /supercommitpre (branching local, no se usa en Vercel)
# NEON_API_KEY=napi_xxxxx  (scoped al proyecto, rol operator — NUNCA commitear)
# NEON_PROJECT_ID=your-project-id
# NEON_PARENT_BRANCH=production  (default: production)
# NEON_PREVIEW_BRANCH=preview   (default: preview)

# Email - Resend
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Error Tracking - Sentry (opcional)
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxxxxxxxxxx.ingest.us.sentry.io/xxxxxx
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project

# Cron - Secret para endpoints protegidos
CRON_SECRET=your-cron-secret-here

# Base URL (override para entornos no-Vercel)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Timezone — usado por lib/date-utils.ts para interpretar fechas como wall-clock local.
# Default: UTC. Ejemplos: "America/Santiago", "Europe/Madrid", "Asia/Tokyo".
APP_TIMEZONE=UTC

# Loop Engineering - Archivo del acumulador de métricas (override para tests/aislamiento)
# Default: .validation/loop-metrics.json
LOOP_METRICS_FILE=.validation/loop-metrics.json

# Loop Engineering - Archivo de sesiones pendientes del timer (--start/--finish)
# Default: junto al acumulador con nombre loop-timers.json
LOOP_TIMERS_FILE=.validation/loop-timers.json

# Loop Engineering - Umbral de rework rate del gate --loop-metrics (iteraciones/evento)
# Si el rework rate supera este valor, el gate bloquea (default 1.5; umbral estricto >)
LOOP_REWORK_THRESHOLD=1.5

# Testing - Playwright
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
# Base URL usada por los specs de API/E2E (tests/api/*, tests/e2e/*)
PLAYWRIGHT_BASE_URL=http://localhost:3000

# AI Code Review (OCR)
OPENCODE_REVIEW_MODEL=openai/gpt-4o
# OPENCODE_REVIEW_API_KEY=

# GitHub - Token para wait-for-ci.js (consultar status de CI antes de push a main)
# GH_TOKEN=github_pat_xxxxxx

# Vercel Blob - Token read/write para upload de fotos de perfil (POST/DELETE /api/user/avatar)
# Generate en: https://vercel.com/docs/storage/vercel-blob/using-blob-sdk#creating-a-blob-store
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# Analytics - TikTok Pixel (opcional)
NEXT_PUBLIC_TIKTOK_PIXEL_ID=ABC123

# OpenCode Zen API Key (get from opencode.ai/auth)
OPENCODE_ZEN_API_KEY=

# Push Notifications (VAPID) — PWA
# Generate keys: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY se expone al client (NEXT_PUBLIC_) — segura por diseño VAPID
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
# Alternativa: VAPID_PUBLIC_KEY funciona igual (NEXT_PUBLIC_ es preferido)
VAPID_PUBLIC_KEY=your-vapid-public-key-here
# VAPID_PRIVATE_KEY es server-only — NUNCA en bundle, tests ni logs
VAPID_PRIVATE_KEY=your-vapid-private-key-here
# VAPID_SUBJECT es mailto: contact para VAPID (server-only)
VAPID_SUBJECT=mailto:admin@yourdomain.com
