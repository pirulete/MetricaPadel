{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/qwen3.6-plus",
  "small_model": "opencode-go/deepseek-v4-flash",
  "default_agent": "build",
  "instructions": [".agents/agents.md", "ARCHITECTURE.md", ".opencode/agents/ponytail-reviewer.md", ".opencode/agents/ui-designer.md"],
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "skill": {
      "*": "allow"
    }
  },
  "autoupdate": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", ".next/**"]
  },
  "provider": {},
  "mcp": {
    "headroom": {
      "type": "local",
      "command": ["docker", "exec", "-i", "headroom-proxy", "headroom", "mcp", "serve", "--proxy-url", "http://localhost:8787"],
      "enabled": true
    },
    "codebase-memory-mcp": {
      "type": "local",
      "command": ["/Users/milo/.local/bin/codebase-memory-mcp"],
      "enabled": true
    },
    "engram": {
      "type": "local",
      "command": ["engram", "mcp", "--tools=agent"],
      "enabled": true
    }
  }
}
