{
  "name": "padel-evaluation",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "next build && pnpm run db:migrate",
    "dev": "next dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "next start",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx tsx scripts/migrate.ts",
    "seed:marketing": "npx tsx scripts/seed-marketing.ts",
    "deploy": "next build && pnpm run db:migrate",
    "test": "playwright test",
    "test:e2e": "playwright test tests/e2e/",
    "test:unit": "jest",
    "perf:lighthouse": "node scripts/lighthouse.mjs",
    "perf:psi": "node scripts/pagespeed.mjs",
    "perf:all": "pnpm perf:lighthouse && pnpm perf:psi",
    "security:secrets": "gitleaks detect --source . --no-git -v",
    "security:secrets:git": "gitleaks detect --source . -v",
    "security:sast": "mkdir -p .validation && semgrep --config=auto --error --json --max-target-bytes=500000 --exclude='node_modules,drizzle,production_artifacts,.next,.unlighthouse,coverage,.validation' -o .validation/semgrep-report.json lib/ app/ 2>&1 | tail -30",
    "security:all": "pnpm run security:secrets && pnpm run security:sast",
    "security:deps": "pnpm audit --audit-level=high",
    "code-review": "node scripts/ocr-review.js",
    "code-review:fix": "node scripts/ocr-review.js --fix",
    "prepare": "husky install"
  },
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@hookform/resolvers": "^3.10.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
