    "@types/web-push": "^3.6.4",
    "chrome-launcher": "^1.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.6.0",
    "husky": "^8.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.4.1",
    "lighthouse": "^13.3.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "tw-animate-css": "1.3.3",
    "typescript": "^5.8",
    "typescript-eslint": "^8.60.1"
  }
